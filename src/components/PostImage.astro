---
import { resizeImage, srcSet } from '../lib/images';

interface Props {
  src: string;
  alt: string;
  widths?: number[];
  sizes?: string;
  priority?: boolean;
}
const { src, alt, widths = [320, 480, 720], sizes = '(max-width: 600px) 100vw, 400px', priority = false } = Astro.props;
const fallbackWidth = widths[Math.min(1, widths.length - 1)];
---

<img
  src={resizeImage(src, fallbackWidth)}
  srcset={srcSet(src, widths)}
  sizes={sizes}
  width={fallbackWidth}
  height={Math.round(fallbackWidth * 0.625)}
  alt={alt}
  loading={priority ? 'eager' : 'lazy'}
  fetchpriority={priority ? 'high' : undefined}
  decoding="async"
/>
