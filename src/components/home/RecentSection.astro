---
import { formatDate, getCategoryLabel } from '../../lib/supabase';

interface Props {
  restPosts: any[];
}

const { restPosts } = Astro.props;
---

{restPosts.length > 0 && (
  <section class="recent-section">
    <div class="container">
      <div class="section-header">
        <h2>Artigos Recentes</h2>
        <a href="/blog" class="see-all">Ver todos →</a>
      </div>
      <div class="recent-grid">
        {restPosts.map((post: any) => (
          <a href={`/blog/${post.id}`} class="post-card">
            <div class="card-image">
              {post.data.image && <img src={post.data.image} alt={post.data.title} loading="lazy" />}
            </div>
            <div class="card-body">
              <span class="card-category">{getCategoryLabel(post.data.category)}</span>
              <h3>{post.data.title}</h3>
              <p>{post.data.excerpt}</p>
              <div class="card-meta">
                <span>{post.data.author}</span>
                <span>•</span>
                <span>{formatDate(post.data.pubDate)}</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 32px;
  }

  .section-header h2 {
    font-size: 32px;
    font-weight: 800;
    color: var(--color-primary-dark);
  }

  .see-all {
    color: var(--color-primary);
    font-weight: 600;
    font-size: 15px;
    transition: color var(--transition);
  }

  .see-all:hover {
    color: var(--color-accent);
  }

  .recent-section {
    padding: 64px 0;
  }

  .recent-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .post-card {
    background: white;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: box-shadow var(--transition), transform var(--transition);
    display: flex;
    flex-direction: column;
  }

  .post-card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-4px);
  }

  .post-card .card-image {
    height: 180px;
    overflow: hidden;
    background: var(--color-border);
  }

  .post-card .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .post-card:hover .card-image img {
    transform: scale(1.05);
  }

  .card-body {
    padding: 20px;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .card-category {
    display: inline-block;
    color: var(--color-accent-dark);
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 12px;
  }

  .post-card .card-body h3 {
    font-size: 18px;
    margin-bottom: 8px;
    transition: color var(--transition);
  }

  .post-card:hover .card-body h3 {
    color: var(--color-accent-dark);
  }

  .card-body p {
    color: var(--color-text-muted);
    font-size: 14px;
    margin: 0 0 16px;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-meta {
    display: flex;
    gap: 8px;
    align-items: center;
    font-size: 13px;
    color: var(--color-text-light);
  }

  @media (max-width: 968px) {
    .recent-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .recent-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
