---
import siteSettings from '../content/settings/site.json';
import '../styles/calculator.css';
import { TIPOS } from '../lib/tijolos';

interface Props {
  heading?: 'h1' | 'h2';
}
const { heading: Heading = 'h2' } = Astro.props;
---

<div class="calc-layout" id="calculadora-de-tijolos">
  <div class="calc-card">
    <Heading>Calculadora de Tijolos</Heading>
    <p class="calc-intro">Informe as medidas da parede e veja quantos tijolos comprar e a argamassa de assentamento.</p>

    <form id="tij-form" novalidate>
      <div class="field-grid">
        <label class="field"><span>Comprimento da parede (m)</span><input type="number" id="tij-comprimento" inputmode="decimal" min="0.5" max="500" step="0.1" value="3" /></label>
        <label class="field"><span>Altura (m)</span><input type="number" id="tij-altura" inputmode="decimal" min="0.5" max="15" step="0.1" value="2.6" /></label>
      </div>
      <div class="field-grid">
        <label class="field"><span>Portas</span><input type="number" id="tij-portas" inputmode="numeric" min="0" max="50" step="1" value="1" /></label>
        <label class="field"><span>Janelas</span><input type="number" id="tij-janelas" inputmode="numeric" min="0" max="50" step="1" value="0" /></label>
      </div>
      <label class="field">
        <span>Tipo de tijolo ou bloco</span>
        <select id="tij-tipo">
          {Object.entries(TIPOS).map(([id, t]) => <option value={id} selected={id === 'tijolo-8f'}>{t.nome}</option>)}
        </select>
      </label>
    </form>

    <div id="tij-alertas" class="alertas" role="status"></div>

    <table class="result-table">
      <thead>
        <tr><th>Resultado</th><th class="qtd">Valor</th></tr>
      </thead>
      <tbody id="tij-resultado"></tbody>
    </table>
    <p id="tij-resumo" class="resumo"></p>

    <div class="calc-actions">
      <a id="tij-whatsapp" class="btn-primary" href="#" target="_blank" rel="noopener noreferrer" data-gtag-event="whatsapp_click">Falar com um especialista</a>
      <a href="/blog/quantos-tijolos-por-m2-parede-argamassa-assentamento/" class="btn-outline">Como o cálculo funciona</a>
    </div>
    <p class="disclaimer">Estimativa com junta de 1 cm e 10% de perda. Portas de 0,80 x 2,10 m e janelas de 1,20 x 1,20 m são descontadas da área. As medidas das peças variam entre fabricantes: confira o catálogo do produto escolhido.</p>
  </div>
</div>

<script define:vars={{ whatsappNumber: siteSettings.whatsappNumber }}>
  window.__WA_NUMBER__ = whatsappNumber;
</script>

<script>
  import { calcularTijolos, TIPOS } from '../lib/tijolos';

  const el = (id: string) => document.getElementById(id) as HTMLInputElement;
  const num = (id: string) => parseFloat(el(id).value.replace(',', '.'));
  const tbody = document.getElementById('tij-resultado')!;
  const alertas = document.getElementById('tij-alertas')!;
  const resumo = document.getElementById('tij-resumo')!;
  const wa = document.getElementById('tij-whatsapp') as HTMLAnchorElement;
  const form = document.getElementById('tij-form')!;

  const f = (n: number, d = 2) => n.toLocaleString('pt-BR', { minimumFractionDigits: 0, maximumFractionDigits: d });

  function row(nome: string, valor: string, opts: { nota?: string; destaque?: boolean } = {}) {
    const tr = document.createElement('tr');
    if (opts.destaque) tr.className = 'destaque';
    const td1 = document.createElement('td');
    td1.textContent = nome;
    if (opts.nota) {
      const s = document.createElement('small');
      s.textContent = opts.nota;
      td1.appendChild(s);
    }
    const td2 = document.createElement('td');
    td2.className = 'qtd';
    td2.textContent = valor;
    tr.append(td1, td2);
    tbody.appendChild(tr);
  }

  function render() {
    tbody.innerHTML = '';
    alertas.innerHTML = '';

    const c = num('tij-comprimento');
    const h = num('tij-altura');
    const portas = parseInt(el('tij-portas').value || '0', 10);
    const janelas = parseInt(el('tij-janelas').value || '0', 10);
    const valido = c >= 0.5 && c <= 500 && h >= 0.5 && h <= 15 && portas >= 0 && janelas >= 0;

    if (!valido) {
      resumo.textContent = 'Informe medidas válidas (comprimento e altura a partir de 0,5 m).';
      wa.removeAttribute('href');
      return;
    }

    const tipo = el('tij-tipo').value;
    const r = calcularTijolos({ comprimento: c, altura: h, portas, janelas, tipo });

    row('Área bruta da parede', `${f(r.areaBruta)} m²`);
    if (r.descontos > 0) row('Portas e janelas', `− ${f(r.descontos)} m²`);
    row('Área a assentar', `${f(r.areaLiquida)} m²`);
    row('Tijolos sem perda', `${f(r.unidades, 0)} un.`);
    row('Compre (com 10% de perda)', `${f(r.unidadesComPerda, 0)} un.`, { destaque: true });
    row('Argamassa de assentamento', `${f(r.argamassaMin, 0)} a ${f(r.argamassaMax, 0)} L`, { nota: 'Referência de 8 a 12 litros por m²' });

    for (const msg of r.alertas) {
      const p = document.createElement('p');
      p.textContent = msg;
      alertas.appendChild(p);
    }

    const nomeTipo = TIPOS[tipo]?.nome ?? '';
    resumo.textContent = `Parede de ${f(c)} x ${f(h)} m em ${nomeTipo}.`;

    const texto = `Olá! Calculei no blog os tijolos de uma parede de ${f(c)} x ${f(h)} m (${nomeTipo}): cerca de ${f(r.unidadesComPerda, 0)} unidades com perda. Preciso da ajuda de um especialista.`;
    wa.href = `https://wa.me/${(window as any).__WA_NUMBER__}?text=${encodeURIComponent(texto)}`;
  }

  form.addEventListener('input', render);
  form.addEventListener('change', render);
  form.addEventListener('submit', (e) => e.preventDefault());
  // Mede o uso da calculadora: um único evento por visita, na primeira interação.
  let usoRegistrado = false;
  form.addEventListener('input', () => {
    if (usoRegistrado) return;
    usoRegistrado = true;
    (window as any).gtag?.('event', 'calculator_use', { calculator: 'tijolos', page_path: window.location.pathname });
  });
  render();
</script>
