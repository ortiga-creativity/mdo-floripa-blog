---
interface Props {
  id: string;
  title: string;
  subtitle: string;
}
const { id, title, subtitle } = Astro.props;
---

<details class="calc-banner" id={id}>
  <summary>
    <span class="banner-icon" aria-hidden="true"><slot name="icon" /></span>
    <span class="banner-text">
      <strong>{title}</strong>
      <span class="banner-sub">{subtitle}</span>
    </span>
    <span class="banner-action">
      <span class="when-closed">Calcular agora</span>
      <span class="when-open">Fechar</span>
      <svg class="chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
    </span>
  </summary>
  <div class="banner-body"><slot /></div>
</details>

<style>
  .calc-banner {
    max-width: 1000px;
    margin: 0 auto 14px;
    background: linear-gradient(135deg, #1D3557 0%, #376EA5 100%);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    border-left: 6px solid var(--color-accent);
    overflow: hidden;
  }
  summary {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 18px 24px;
    cursor: pointer;
    color: white;
    list-style: none;
  }
  summary::-webkit-details-marker { display: none; }
  .banner-icon {
    flex-shrink: 0;
    width: 52px;
    height: 52px;
    border-radius: 12px;
    background: var(--color-accent);
    color: var(--color-primary-dark);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .banner-text { display: flex; flex-direction: column; flex: 1; min-width: 0; }
  .banner-text strong { font-size: 20px; font-weight: 800; }
  .banner-sub { font-size: 14px; color: rgba(255,255,255,0.75); }
  .banner-action {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--color-accent);
    color: var(--color-primary-dark);
    font-weight: 700;
    font-size: 14px;
    padding: 10px 16px;
    border-radius: var(--radius-md);
    white-space: nowrap;
  }
  .when-open { display: none; }
  .calc-banner[open] .when-open { display: inline; }
  .calc-banner[open] .when-closed { display: none; }
  .chevron { transition: transform 0.3s; }
  .calc-banner[open] .chevron { transform: rotate(180deg); }
  summary:hover .banner-action { background: var(--color-accent-light); }
  .banner-body { padding: 0 24px 24px; }

  @media (max-width: 600px) {
    summary { padding: 14px 16px; gap: 12px; }
    .banner-icon { width: 42px; height: 42px; }
    .banner-text strong { font-size: 17px; }
    .banner-sub { display: none; }
    .banner-action { font-size: 13px; padding: 8px 12px; }
    .banner-body { padding: 0 12px 16px; }
  }
</style>
