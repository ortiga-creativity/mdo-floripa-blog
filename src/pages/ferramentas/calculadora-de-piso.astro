---
import Layout from '../../layouts/Layout.astro';
import HelmetIcon from '../../components/HelmetIcon.astro';
import PisoCalculator from '../../components/PisoCalculator.astro';

const pageUrl = 'https://locacaoequipamentos.blog.br/ferramentas/calculadora-de-piso/';

const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Calculadora de Piso e Porcelanato',
  url: pageUrl,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  inLanguage: 'pt-BR',
  description: 'Calcule as caixas de piso ou porcelanato, a argamassa colante e o rejunte de um ambiente, considerando a perda do tipo de assentamento.',
  publisher: { '@type': 'Organization', name: 'MDO Floripa - Mestre da Obra Locações' },
};
---

<Layout
  title="Calculadora de Piso e Porcelanato: caixas, argamassa e rejunte - MDO Floripa"
  description="Informe o ambiente e a peça e veja quantas caixas de piso ou porcelanato comprar, a argamassa colante e o rejunte, com a perda do tipo de assentamento."
>
  <script type="application/ld+json" set:html={JSON.stringify(appSchema)} />

  <section class="page-hero">
    <div class="container">
      <span class="breadcrumb"><a href="/">Início</a> / <a href="/ferramentas/">Ferramentas</a> / Calculadora de Piso e Porcelanato</span>
      <div class="hero-badge-row">
        <HelmetIcon size={24} color="#F5A623" />
        <span>MDO Floripa</span>
      </div>
      <h1>Calculadora de Piso e Porcelanato</h1>
      <p>Informe o ambiente e a peça e veja quantas caixas, argamassa e rejunte comprar.</p>
    </div>
  </section>

  <section class="calc-section">
    <div class="container">
      <PisoCalculator heading="h2" />
      <p class="read-more">Quer entender melhor o cálculo? <a href="/blog/como-calcular-piso-porcelanato-argamassa-e-rejunte/">Leia: Como calcular piso, argamassa e rejunte →</a></p>
    </div>
  </section>
</Layout>

<style>
  .container { max-width: 1280px; margin: 0 auto; padding: 0 24px; }

  .page-hero {
    background: linear-gradient(135deg, #1D3557 0%, #376EA5 100%);
    color: white;
    padding: 140px 24px 64px;
  }
  .breadcrumb { font-size: 14px; color: rgba(255,255,255,0.5); margin-bottom: 16px; display: block; }
  .breadcrumb a { color: rgba(255,255,255,0.7); transition: color 0.3s; }
  .breadcrumb a:hover { color: #F5A623; }
  .hero-badge-row { display: inline-flex; align-items: center; gap: 10px; color: #F5A623; font-size: 14px; font-weight: 600; margin-bottom: 16px; }
  .page-hero h1 { font-size: 44px; font-weight: 900; margin-bottom: 12px; color: white; }
  .page-hero p { font-size: 18px; color: rgba(255,255,255,0.75); max-width: 640px; }

  .calc-section { padding: 48px 0 0; }
  .read-more { text-align: center; margin-top: 24px; font-size: 15px; color: var(--color-text-muted); }
  .read-more a { color: var(--color-accent-dark); font-weight: 600; }

  @media (max-width: 968px) { .page-hero h1 { font-size: 32px; } }
  @media (max-width: 600px) { .page-hero h1 { font-size: 26px; } }
</style>
